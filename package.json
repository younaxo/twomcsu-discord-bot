{
  "name": "twomcsu-discord-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Discord-бот и веб-панель управления TWOMC.SU",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "build:packages": "pnpm --filter @twomcsu/shared build && pnpm --filter @twomcsu/db build",
    "dev:bot": "pnpm build:packages && pnpm --filter @twomcsu/bot dev",
    "dev:web": "pnpm build:packages && pnpm --filter @twomcsu/web dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @twomcsu/db generate",
    "db:migrate": "pnpm --filter @twomcsu/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @twomcsu/db migrate:dev",
    "db:seed": "pnpm --filter @twomcsu/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
