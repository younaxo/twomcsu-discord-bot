# Пример переменных окружения. Скопируйте в .env и заполните реальными значениями.
# Настоящий .env никогда не коммитится и не должен покидать сервер/локальную машину.

# --- Discord-приложение ---
# Токен бота из вкладки Bot в Discord Developer Portal.
DISCORD_BOT_TOKEN=
# Application ID (он же Client ID) приложения.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
# Client Secret из вкладки OAuth2.
DISCORD_CLIENT_SECRET=
# Public Key из General Information (нужен, если используются HTTP-интеракции; discord.js gateway его не требует, но храним для совместимости).
DISCORD_PUBLIC_KEY=
# ID сервера (guild), для которого регистрируются команды и проверяется доступ к панели.
DISCORD_GUILD_ID=
# ID роли, дающей доступ к веб-панели.
DISCORD_PANEL_ACCESS_ROLE_ID=
# Redirect URI, зарегистрированный в OAuth2 приложении.
DISCORD_OAUTH_REDIRECT_URI=https://bot.twomc.su/api/auth/callback/discord

# --- База данных ---
POSTGRES_DB=twomcsu_bot
POSTGRES_USER=twomcsu_bot
POSTGRES_PASSWORD=
# Строка подключения Prisma. В docker-compose хост — имя сервиса "postgres".
DATABASE_URL=postgresql://twomcsu_bot:PASSWORD@postgres:5432/twomcsu_bot?schema=public

# --- Веб-панель ---
# Публичный домен без протокола.
PUBLIC_DOMAIN=bot.twomc.su
# Полный публичный URL панели, используется в OAuth и абсолютных ссылках.
APP_URL=https://bot.twomc.su
# Секрет для подписи/шифрования сессионных cookie. Генерируется командой:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Ключ для шифрования чувствительных полей в БД (32 байта в hex).
ENCRYPTION_KEY=

# --- Внутреннее взаимодействие web <-> bot ---
# Секрет для аутентификации запросов веб-панели к внутреннему API бота.
# Порт бота наружу не публикуется — доступен только внутри docker-сети.
INTERNAL_API_SECRET=
INTERNAL_API_URL=http://bot:3001

# --- Общее ---
NODE_ENV=production
LOG_LEVEL=info
